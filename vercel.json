{
  "version": 2,
  "builds": [
    {
      "src": "BlockChain/server.py",
      "use": "@vercel/python"
    },
    {
      "src": "BlockChain/login.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "BlockChain/server.py"
    },
    {
      "src": "/",
      "dest": "BlockChain/login.html"
    }
  ]
}